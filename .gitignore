migrate_working_dir/

# Agentic kit local runtime state (not source; regenerated by `cli.py init`)
/agentic/data/runtime/state/
/agentic/data/runtime/logs/
/agentic/data/artifacts/
/agentic-backups/
__pycache__/
*.py[cod]

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# FVM Version Cache
.fvm/
.env

# Release signing (never commit - loss blocks all future app updates)
/android/key.properties
/android/keystore/
*.jks
*.keystore